# API-Keys hier eintragen, Datei nach .env kopieren. .env wird NICHT committet.
# Alles ist OPTIONAL — ohne Keys läuft das Tool vollständig (graceful degradation).
# Trage Secrets NUR hier-kopiert in .env ein, NIE in diese .env.example (committet/öffentlich).

# Dimension 3 (Mobile & Performance): echte Core Web Vitals via Google PageSpeed
# Insights (Lighthouse). Ohne Key -> leichtere Viewport-Heuristik.
PAGESPEED_API_KEY=

# Zahlungskräftigkeit: autoritative Rechtsform/Status aus dem Handelsregister (Zefix).
# BEIDE Variablen nötig, sonst Fallback auf die Namens-/Branchen-Heuristik.
# Zugang anfragen: zefix@bj.admin.ch
ZEFIX_USER=
ZEFIX_PASSWORD=

# Reserviert für künftige LLM-Anreicherung (v2, DIFF-02) — aktuell ungenutzt.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
